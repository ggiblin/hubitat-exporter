# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will never be committed.

# Full Maker API devices URL from your Hubitat hub.
# Hubitat UI → Apps → Maker API → "Get All Devices" URL, without ?access_token=...
HE_URI=http://YOUR_HUB_IP/apps/api/APP_ID/devices

# Maker API access token shown on the same Maker API page.
HE_TOKEN=your-maker-api-token-here
